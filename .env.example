# Railway PostgreSQL bağlantı adresi (Railway panelinden "Connect" > "Postgres Connection URL")
# Örnek: postgresql://postgres:PAROLA@HOST:PORT/railway
# Boş bırakılırsa site bellek-içi geçici kayıtla çalışır (kalıcı değildir).
DATABASE_URL=

# Sunucu portu (Railway otomatik atar; lokal için 3000)
PORT=3000

# Yönetim paneli şifresi. Production'da zorunludur.
ADMIN_PASSWORD=degistirilecek-guclu-sifre

# Cookie imzası için ayrı gizli değer. Boş bırakılırsa ADMIN_PASSWORD kullanılır.
ADMIN_SESSION_SECRET=degistirilecek-uzun-rastgele-deger
